# Settings for scripts/start_live.py and scripts/eval_agent.py. Never commit or share this file.
# Values already exported in your terminal take priority over this file.

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional voice tuning. Eleven v4 only uses stability: lower is more expressive (0.3-0.5),
# higher is steadier but flatter (0.6-0.85). Speed only affects older models such as eleven_flash_v2_5.
ELEVENLABS_STABILITY=0.4
# ELEVENLABS_SPEED=0.95
# ELEVENLABS_LIVE_MODEL=eleven_v4_turbo
# LIVE_LLM_MODEL=gpt-5.4-mini
